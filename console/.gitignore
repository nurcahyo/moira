# dependencies
node_modules/

# next.js
.next/
out/

# production
build/
dist/

# testing
playwright-report/
test-results/
coverage/
# The setup-wizard e2e fixture's generated TLS material. Regenerated on demand
# by e2e/support/setup-fixture.ts; a private key never belongs in the tree.
.setup-e2e/
# Next.js writes `certificates/localhost.pem` and `certificates/localhost-key.pem`
# here the first time anyone runs `bun run dev --experimental-https`, which is the
# HTTPS recipe `docs/local-testing.md:550` tells developers to use. Same reasoning
# as `.setup-e2e/` above, but this one is reached by following the documented
# happy path rather than by running the e2e suite, so it appears in more trees.
# This repository is public: an unignored private key is one `git add -A` away
# from being published, and `git add -A` in a stale worktree has already cost
# this project real work once.
certificates/

# env
.env
.env.local
.env.*.local
# `make env-force` moves the current file aside under this name; it still holds
# BETTER_AUTH_SECRET and CONSOLE_SECRET_ENCRYPTION_KEY.
.env.local.bak
# The in-place edits leave a copy of the same file behind under these suffixes:
# `scripts/bootstrap-key.sh` uses `sed -i.keytmp`, `make console-db` uses
# `sed -i.sedtmp`. Both suffixes are required by BSD sed, not optional.
.env.local.keytmp
.env.local.sedtmp

# typescript
*.tsbuildinfo
next-env.d.ts

# misc
.DS_Store
*.log
