/target

# scripts/ci-shard-run.sh's evidence output — assigned.txt, ran.txt, skips.txt and the
# cargo capture. Uploaded as a CI artifact; a local shard reproduction leaves it here.
/shard-out

# Local configuration. `scripts/dev-env.sh` writes a real 32-byte master key, an
# API-key pepper and a content-encryption master key (`MOIRA_CONTENT_ENCRYPTION__KEYS`,
# an "id:base64" list) into `.env`, and `config/local.toml` is the TOML equivalent —
# neither was ignored before that generator existed.
/.env
/.env.bak
/config/local.toml

# `scripts/bootstrap-key.sh` edits `.env` with `sed -i.keytmp`. BSD sed needs a
# suffix, so a full copy of the file — key material and all — exists for the
# length of that call, and survives it if the command fails partway.
/.env.keytmp

# macOS Finder metadata. `console/.gitignore` already had this; the root did not,
# so a `git add .` from the repo root would have committed it.
.DS_Store

# cargo-mutants scratch tree and outcome report (scripts/mutants.sh)
/mutants.out
/mutants.out.old

# console/ (Next.js workspace)
node_modules/
.next/
playwright-report/
test-results/
console/out/
console/build/
console/dist/
console/coverage/
console/*.tsbuildinfo
console/next-env.d.ts
