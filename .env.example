MOIRA_DEPLOYMENT__ENVIRONMENT=development
MOIRA_SERVER__HOST=127.0.0.1
MOIRA_SERVER__PORT=8080
MOIRA_DATABASE__URL=postgres://postgres:postgres@localhost:5432/moira
MOIRA_DATABASE__REQUIRE=true
MOIRA_DATABASE__MIGRATE_ON_STARTUP=true
MOIRA_SECRETS__MASTER_KEY_BASE64=replace-with-32-byte-base64-key
MOIRA_SECRETS__KEY_ID=local-2026-07
MOIRA_SECRETS__ALLOW_INSECURE_DEV_KEY=false
# Content encryption at rest. REQUIRED in production — the service refuses to start without it,
# even on a deployment where no application stores encrypted content today, because the
# persistence policy is flippable at runtime through the admin API without a restart.
# Format: "<id>:<base64>,<id>:<base64>". Mint with `openssl rand -base64 32`. Keep every key an
# existing row may have been sealed under listed here through a rotation.
# There is no fallback to MOIRA_SECRETS__MASTER_KEY_BASE64; leaving this unset is a refusal.
MOIRA_CONTENT_ENCRYPTION__CUSTODY=environment
MOIRA_CONTENT_ENCRYPTION__KEYS=content-2026-07:replace-with-32-byte-base64-key
MOIRA_CONTENT_ENCRYPTION__ACTIVE_KEY_ID=content-2026-07
MOIRA_CONTENT_ENCRYPTION__ALLOW_INSECURE_DEV_KEY=false
MOIRA_AUTH__ADMIN__ENABLED=true
MOIRA_AUTH__ADMIN__JWKS_URL=https://issuer.example.com/.well-known/jwks.json
MOIRA_AUTH__ADMIN__ISSUER=https://issuer.example.com/
MOIRA_AUTH__ADMIN__AUDIENCE=moira-admin
MOIRA_AUTH__ADMIN__REQUIRED_SCOPE=moira.admin
MOIRA_AUTH__CALLER__ENABLED=false
MOIRA_AUTH__CALLER__DEV_TRUST_HEADERS=false
MOIRA_API_KEYS__PEPPER_BASE64=replace-with-32-byte-base64-pepper
MOIRA_API_KEYS__PEPPER_VERSION=local-2026-07
MOIRA_API_KEYS__ALLOW_INSECURE_DEV_PEPPER=false
MOIRA_API_KEYS__PREFIX_LENGTH=20
MOIRA_PROVIDER_SECURITY__ALLOW_PRIVATE_PROVIDER_URLS=false
MOIRA_PROVIDER_SECURITY__ALLOW_HTTP_PROVIDER_URLS=false
MOIRA_CORS__ALLOWED_ORIGINS=http://localhost:3000
MOIRA_DOCS__EXPOSE_ADMIN=false
MOIRA_REDIS__ENABLED=false
MOIRA_REDIS__URL=redis://localhost:6379/0
MOIRA_REDIS__NAMESPACE=moira
MOIRA_REDIS__CONNECT_TIMEOUT_SECONDS=2
MOIRA_REDIS__INVALIDATION_CHANNEL=moira:runtime-config
MOIRA_WORKERS__ENABLED=false
MOIRA_WORKERS__SHUTDOWN_GRACE_SECONDS=30
MOIRA_WORKERS__MAX_CONCURRENT_JOBS=8
MOIRA_WORKERS__RETRY_BASE_DELAY_SECONDS=5
MOIRA_WORKERS__RETRY_MAX_DELAY_SECONDS=300
MOIRA_WORKERS__DEAD_LETTER_RETENTION_HOURS=168
MOIRA_TELEMETRY__PROMETHEUS_ENABLED=false
MOIRA_TELEMETRY__METRICS_PATH=/metrics
MOIRA_TELEMETRY__OTEL_ENABLED=false
# OTLP/HTTP (http-proto), so this is the HTTP port 4318, not the gRPC 4317.
MOIRA_TELEMETRY__OTEL_ENDPOINT=http://localhost:4318
MOIRA_LIVE_VLLM_URL=http://192.168.1.13:8000
# Containerised Claude runners (issues #272, #275, #273). TWO processes, two prefixes, and
# they are easy to confuse:
#
#   MOIRA_CLAUDE_RUNNER__*  — read by the `moira` binary. How Moira REACHES the runner service.
#   MOIRA_RUNNER__*         — read by the `moira-runner` binary. How that service itself runs.
#
# `moira-runner` is the only component with Docker Engine API access, which is root-equivalent
# on its host; Moira calls it over HTTP and holds no Docker access of its own.

# --- Moira's side: the client. Off by default. -------------------------------------------
# The token authenticates a root-equivalent service, so it lives here and never in a committed
# config file, and production start-up refuses a non-loopback http:// base URL.
MOIRA_CLAUDE_RUNNER__ENABLED=false
MOIRA_CLAUDE_RUNNER__BASE_URL=http://127.0.0.1:8090
MOIRA_CLAUDE_RUNNER__AUTH_TOKEN=replace-with-the-token-moira-runner-was-started-with
MOIRA_CLAUDE_RUNNER__REQUEST_TIMEOUT_MS=10000

# --- The runner service's own configuration (src/bin/moira-runner.rs) ---------------------
# Not read by the `moira` binary; see docs/moira-runner.md. The first two are commented out
# because the service refuses to start without a real control token and a content-pinned
# image, and a sample value for either would be worse than no value at all.
#
# MOIRA_RUNNER__CONTROL_TOKEN must be the same value as MOIRA_CLAUDE_RUNNER__AUTH_TOKEN above,
# and MOIRA_RUNNER__BIND must be the authority in MOIRA_CLAUDE_RUNNER__BASE_URL.
# MOIRA_RUNNER__CONTROL_TOKEN=          # openssl rand -hex 32 — never a placeholder word
# MOIRA_RUNNER__IMAGE=                  # sha256:<64 hex> from scripts/build-claude-runner-image.sh
# MOIRA_RUNNER__BIND=127.0.0.1:8090
# Docker Desktop for macOS does not create /var/run/docker.sock unless you enable the
# compatibility symlink, and bollard does not read the docker CLI's context — so `docker
# version` can work while the runner reports "Socket not found".
# MOIRA_RUNNER__DOCKER_HOST=unix:///Users/you/.docker/run/docker.sock
