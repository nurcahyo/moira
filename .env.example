MOIRA_SERVER__HOST=127.0.0.1
MOIRA_SERVER__PORT=8080
MOIRA_DATABASE__URL=postgres://postgres:postgres@localhost:5432/moira
MOIRA_DATABASE__REQUIRE=true
MOIRA_SECRETS__MASTER_KEY_BASE64=replace-with-32-byte-base64-key
MOIRA_SECRETS__KEY_ID=local-2026-07
MOIRA_SECRETS__ALLOW_INSECURE_DEV_KEY=false
MOIRA_AUTH__ADMIN__ENABLED=true
MOIRA_AUTH__ADMIN__JWKS_URL=https://issuer.example.com/.well-known/jwks.json
MOIRA_AUTH__ADMIN__ISSUER=https://issuer.example.com/
MOIRA_AUTH__ADMIN__AUDIENCE=moira-admin
MOIRA_AUTH__ADMIN__REQUIRED_SCOPE=moira.admin
MOIRA_AUTH__CALLER__ENABLED=false
MOIRA_AUTH__CALLER__DEV_TRUST_HEADERS=true
MOIRA_API_KEYS__PEPPER_BASE64=replace-with-32-byte-base64-pepper
MOIRA_API_KEYS__PEPPER_VERSION=local-2026-07
MOIRA_API_KEYS__ALLOW_INSECURE_DEV_PEPPER=false
MOIRA_API_KEYS__PREFIX_LENGTH=20
MOIRA_PROVIDER_SECURITY__ALLOW_PRIVATE_PROVIDER_URLS=false
MOIRA_PROVIDER_SECURITY__ALLOW_HTTP_PROVIDER_URLS=false
MOIRA_DOCS__EXPOSE_ADMIN=false
MOIRA_REDIS__ENABLED=false
MOIRA_REDIS__URL=redis://localhost:6379/0
MOIRA_REDIS__NAMESPACE=moira
MOIRA_REDIS__CONNECT_TIMEOUT_SECONDS=2
MOIRA_REDIS__INVALIDATION_CHANNEL=moira:runtime-config
MOIRA_WORKERS__ENABLED=false
MOIRA_WORKERS__SHUTDOWN_GRACE_SECONDS=30
MOIRA_WORKERS__MAX_CONCURRENT_JOBS=8
MOIRA_WORKERS__RETRY_BASE_DELAY_SECONDS=5
MOIRA_WORKERS__RETRY_MAX_DELAY_SECONDS=300
MOIRA_WORKERS__DEAD_LETTER_RETENTION_HOURS=168
MOIRA_TELEMETRY__PROMETHEUS_ENABLED=false
MOIRA_TELEMETRY__METRICS_PATH=/metrics
MOIRA_TELEMETRY__OTEL_ENABLED=false
MOIRA_TELEMETRY__OTEL_ENDPOINT=http://localhost:4317
MOIRA_LIVE_VLLM_URL=http://192.168.1.13:8000
